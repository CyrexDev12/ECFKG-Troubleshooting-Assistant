# Set these in your shell. This file is documentation, not automatically loaded.
ECFKG_API_BASE_URL=https://api.openai.com/v1
# Auto uses Responses for OpenAI; Chat Completions for other providers.
ECFKG_API_PROTOCOL=auto
ECFKG_MODEL=
ECFKG_API_KEY=
# OPENAI_API_KEY is accepted when ECFKG_API_KEY is unset.
ECFKG_API_RESPONSE_FORMAT=json_schema
# Some compatible providers use json_object and/or max_tokens instead.
ECFKG_API_TOKEN_PARAMETER=max_completion_tokens

